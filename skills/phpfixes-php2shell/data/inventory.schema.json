{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inventory_version": {
      "const": 1
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 50
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,49}$"
        },
        "version_id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]{0,50}$"
        }
      },
      "required": [
        "id",
        "version_id"
      ]
    },
    "packages": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?:php(?:[0-9]+(?:\\.[0-9]+)?)?-(?:cli|fpm|cgi)|libapache2-mod-php(?:[0-9]+(?:\\.[0-9]+)?)?)(?::[a-z0-9][a-z0-9-]{0,19})?$"
          },
          "version": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^\\d[A-Za-z0-9.+:~_%\\-]*$"
          }
        },
        "required": [
          "name",
          "version"
        ]
      }
    },
    "processes": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "executable_name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^php(?:-fpm|-cgi)?(?:[0-9]+(?:\\.[0-9]+)?)?$"
          },
          "package_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "binary_identity": {
            "enum": [
              "matches-installed",
              "deleted-or-different",
              "unknown"
            ]
          }
        },
        "required": [
          "pid",
          "executable_name",
          "package_name",
          "binary_identity"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_database": {
          "enum": [
            "complete",
            "limited",
            "unavailable"
          ]
        },
        "process_scan": {
          "enum": [
            "complete",
            "limited",
            "unavailable"
          ]
        },
        "unreadable_processes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "vanished_processes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "apache_processes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "limits_reached": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": [
              "time",
              "process-count",
              "process-records",
              "package-count",
              "database-bytes",
              "package-list-bytes"
            ]
          }
        }
      },
      "required": [
        "package_database",
        "process_scan",
        "unreadable_processes",
        "vanished_processes"
      ]
    }
  },
  "required": [
    "inventory_version",
    "collected_at",
    "os",
    "packages",
    "processes",
    "coverage"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal local PHP inventory",
  "description": "Non-secret local metadata. The normalizer also checks duplicate identities, package references and executable interfaces. Collection is optional and explicitly authorized."
}
